---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cover from '@/components/Cover.astro';
import PostGrid from '@/components/PostGrid.astro';
import { getPosts, postUrl } from '@/lib/posts';
import { formatDate, joinLabel, useT } from '@/i18n/ui';
import { LANGS, SITE, type Lang } from '@/site.config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const posts = await getPosts(lang);
const [latest, ...rest] = posts;
const translations = Object.fromEntries(LANGS.map((l) => [l, `/${l}/`]));
const description =
  lang === 'ko'
    ? '개발 이야기와 학습 기록, 그리고 이런저런 생각을 적습니다.'
    : 'Notes on development, learning, and other thoughts.';
---

<BaseLayout lang={lang} description={description} translations={translations} nav="posts">
  <div class="container home">
    {
      latest ? (
        <a href={postUrl(latest)} class="featured">
          <div class="featured-cover">
            <Cover post={latest} size="lg" eager label={joinLabel(t('home.latest'), latest.data.tags[0])} />
          </div>
          <div class="featured-body">
            <span class="meta">
              {formatDate(latest.data.pubDate, lang)}
              {latest.data.series && ` · ${t('series.title')} ${latest.data.series.title}`}
            </span>
            <h1 class="featured-title">{latest.data.title}</h1>
            <p class="featured-desc">{latest.data.description}</p>
            <span class="read">{t('home.read')}</span>
          </div>
        </a>
      ) : (
        <p class="empty">{t('home.empty')}</p>
      )
    }

    {
      rest.length > 0 && (
    <section class="recent" aria-labelledby="recent-title">
      <div class="recent-head">
        <h2 id="recent-title" class="recent-title">{t('home.recent')}</h2>
        <nav class="chips" aria-label={t('nav.tags')}>
          <a class="chip" href={`/${lang}/`} aria-current="page">{t('home.all')}</a>
          {SITE.pinnedTags.map((tag) => <a class="chip" href={`/${lang}/tags/${tag}/`}>{tag}</a>)}
        </nav>
      </div>
      <PostGrid posts={rest} />
    </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .home {
    padding-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .featured {
    display: flex;
    gap: 40px;
    align-items: stretch;
    flex-wrap: wrap;
    text-decoration: none;
  }
  .featured-cover {
    flex: 1 1 520px;
    display: flex;
  }
  .featured-body {
    flex: 1 1 360px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }
  .meta {
    font-size: 14px;
    color: var(--muted);
  }
  .featured-title {
    margin: 0;
    font-size: clamp(26px, 3.4vw, 34px);
    line-height: 1.3;
    letter-spacing: -0.03em;
  }
  .featured-desc {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
  }
  .read {
    font-size: 15px;
    font-weight: 700;
    color: var(--accent-text);
  }
  .recent {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .recent-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .recent-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
  }
  .chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .empty {
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .home {
      padding-top: 24px;
      gap: 40px;
    }
    .featured {
      gap: 20px;
    }
    .featured-cover,
    .featured-body {
      flex-basis: 100%;
    }
  }
</style>
