---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, getSeriesList } from '@/lib/posts';
import { useT } from '@/i18n/ui';
import { LANGS, type Lang } from '@/site.config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const seriesList = getSeriesList(await getPosts(lang));
const translations = Object.fromEntries(LANGS.map((l) => [l, `/${l}/series/`]));
---

<BaseLayout lang={lang} title={t('series.title')} translations={translations} nav="series">
  <div class="container page">
    <h1 class="page-title">{t('series.title')}</h1>
    {
      seriesList.length > 0 ? (
        <ul class="list">
          {seriesList.map((s) => (
            <li>
              <a class="item" href={`/${lang}/series/${s.id}/`}>
                <span class="eyebrow">{t('series.label')}</span>
                <span class="name">{s.title}</span>
                <span class="count">
                  {s.posts.length} {t('series.count')}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">{t('home.empty')}</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border-radius: 20px;
    background: var(--tint);
    text-decoration: none;
  }
  .name {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
  }
  .count,
  .muted {
    font-size: 14px;
    color: var(--muted);
  }
</style>
