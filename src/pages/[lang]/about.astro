---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LANGS, SITE, type Lang } from '@/site.config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const translations = Object.fromEntries(LANGS.map((l) => [l, `/${l}/about/`]));

const copy = {
  ko: {
    title: 'About',
    hello: '안녕하세요, yhslog입니다.',
    intro:
      '20년 가까이 소프트웨어를 만들어 온 개발자입니다. 지금은 주로 React로 프론트엔드를 만들고, React Native와 C/C++, Java도 다룹니다.',
    blogHeading: '이 블로그에는',
    topics: [
      { tag: 'dev', desc: '개발하며 만든 것과 깨달은 것' },
      { tag: 'til', desc: '새로 배운 기술과 언어 공부 기록' },
      { tag: 'essay', desc: '일과 삶, 그리고 그다음에 대한 생각' },
    ],
    nowHeading: '요즘 하는 것',
    now: [
      ['이 블로그 만들기', 'Astro'],
      ['영어 공부', 'English'],
      ['스페인어 공부', 'Español'],
    ],
  },
  en: {
    title: 'About',
    hello: "Hi, I'm yhslog.",
    intro:
      "I'm a software developer with nearly 20 years of experience. These days I mostly build front-ends with React, and I also work with React Native, C/C++, and Java.",
    blogHeading: 'On this blog',
    topics: [
      { tag: 'dev', desc: 'Things I build and learn while developing' },
      { tag: 'til', desc: 'Notes on new tech and language learning' },
      { tag: 'essay', desc: 'Thoughts on work, life, and what comes next' },
    ],
    nowHeading: 'Now',
    now: [
      ['Building this blog', 'Astro'],
      ['Learning English', 'English'],
      ['Learning Spanish', 'Español'],
    ],
  },
}[lang];
---

<BaseLayout lang={lang} title={copy.title} description={copy.intro} translations={translations} nav="about">
  <div class="container about">
    <section class="intro">
      <div class="avatar" aria-hidden="true">y</div>
      <h1 class="page-title hello">{copy.hello}</h1>
      <p class="lead">{copy.intro}</p>
      <div class="links">
        <a class="btn btn--solid" href={SITE.social.github} rel="me">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
          GitHub
        </a>
        {
          SITE.social.linkedin && (
            <a class="btn" href={SITE.social.linkedin} rel="me">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></svg>
              LinkedIn
            </a>
          )
        }
      </div>
    </section>

    <section class="block">
      <h2 class="eyebrow">{copy.blogHeading}</h2>
      <div class="topics">
        {
          copy.topics.map((tp) => (
            <a class="topic" href={`/${lang}/tags/${tp.tag}/`}>
              <span class="topic-tag">#{tp.tag}</span>
              <span class="topic-desc">{tp.desc}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="block">
      <h2 class="eyebrow">{copy.nowHeading}</h2>
      <ul class="now">
        {
          copy.now.map(([what, note]) => (
            <li>
              <span>{what}</span>
              <span class="note">{note}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: 760px;
    padding-top: 88px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .avatar {
    width: 88px;
    height: 88px;
    border-radius: 28px;
    background: var(--accent);
    color: var(--on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 700;
  }
  .hello {
    font-size: clamp(32px, 5vw, 48px);
  }
  .lead {
    margin: 0;
    font-size: 19px;
    line-height: 1.8;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .btn {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }
  .btn--solid {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .block h2 {
    margin: 0;
  }
  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .topic {
    padding: 22px;
    border-radius: 16px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }
  .topic-tag {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
  }
  .topic-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
  .now {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .now li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .note {
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .about {
      padding-top: 48px;
    }
  }
</style>
