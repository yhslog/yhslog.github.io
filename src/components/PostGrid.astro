---
import PostCard from '@/components/PostCard.astro';
import type { Post } from '@/lib/posts';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="grid">
  {
    posts.map((p) => (
      <li>
        <PostCard post={p} />
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr));
    gap: 24px;
  }
  @media (max-width: 640px) {
    .grid {
      gap: 14px;
    }
  }
</style>
