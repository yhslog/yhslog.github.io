---
import { SITE, type Lang } from '@/site.config';
import { useT } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <span>© {year} {SITE.author}</span>
    <div class="links">
      <a href={`/${lang}/rss.xml`}>{t('footer.rss')}</a>
      <a href={SITE.social.github} rel="me">GitHub</a>
      {SITE.social.linkedin && <a href={SITE.social.linkedin} rel="me">LinkedIn</a>}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 96px;
  }
  .inner {
    padding-top: 32px;
    padding-bottom: 32px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 20px;
  }
</style>
