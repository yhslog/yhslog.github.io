---
import Cover from '@/components/Cover.astro';
import { postLang, postUrl, type Post } from '@/lib/posts';
import { formatDate } from '@/i18n/ui';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const lang = postLang(post);
---

<a class="card" href={postUrl(post)}>
  <Cover post={post} size="sm" />
  <div class="body">
    {post.data.tags.length > 0 && <span class="tags">{post.data.tags.map((t) => `#${t}`).join(' ')}</span>}
    <h3 class="title">{post.data.title}</h3>
    <time class="date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
  </div>
</a>

<style>
  .card {
    display: flex;
    gap: 20px;
    align-items: center;
    padding: 20px;
    border-radius: 16px;
    background: var(--surface);
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
  }
  .body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tags {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-text);
  }
  .title {
    margin: 0;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 700;
  }
  .date {
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .card {
      padding: 14px;
      gap: 14px;
    }
    .title {
      font-size: 16px;
    }
  }
</style>
