---
import { SITE, type Lang } from '@/site.config';
import { useT } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const { repo, repoId, category, categoryId } = SITE.giscus;
const enabled = Boolean(repo && repoId && category && categoryId);
---

{
  enabled && (
    <section class="comments" aria-labelledby="comments-title">
      <h2 id="comments-title">{t('post.comments')}</h2>
      <div
        class="giscus-host"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-lang={lang}
      />
    </section>
  )
}

<script>
  const host = document.querySelector<HTMLElement>('.giscus-host');

  const giscusTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

  if (host) {
    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.async = true;
    s.crossOrigin = 'anonymous';
    const attrs: Record<string, string> = {
      'data-repo': host.dataset.repo!,
      'data-repo-id': host.dataset.repoId!,
      'data-category': host.dataset.category!,
      'data-category-id': host.dataset.categoryId!,
      'data-mapping': 'pathname',
      'data-strict': '1',
      'data-reactions-enabled': '1',
      'data-emit-metadata': '0',
      'data-input-position': 'top',
      'data-theme': giscusTheme(),
      'data-lang': host.dataset.lang!,
      'data-loading': 'lazy',
    };
    for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
    host.appendChild(s);

    document.addEventListener('themechange', () => {
      const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: giscusTheme() } } }, 'https://giscus.app');
    });
  }
</script>

<style>
  .comments {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  h2 {
    margin: 0;
    font-size: 20px;
  }
  .giscus-host {
    min-height: 120px;
  }
</style>
