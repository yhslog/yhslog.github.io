---
import type { MarkdownHeading } from 'astro';
import { useT } from '@/i18n/ui';
import type { Lang } from '@/site.config';

interface Props {
  headings: MarkdownHeading[];
  lang: Lang;
}
const { headings, lang } = Astro.props;
const t = useT(lang);
const hasToc = headings.length > 0;
---

<div class="capsule-bar" data-capsule hidden>
  {
    hasToc && (
      <button type="button" class="capsule capsule-section" data-toc-open aria-haspopup="dialog">
        <span class="capsule-fill" aria-hidden="true" />
        <span class="capsule-content">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
          </svg>
          <span class="sr-only">{t('post.tocOpen')}: </span>
          <span class="capsule-title" data-current-section>
            {headings[0].text}
          </span>
        </span>
      </button>
    )
  }
  <button type="button" class="capsule capsule-top" data-back-to-top aria-label={t('post.backToTop')}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
  </button>
</div>

{
  hasToc && (
    <dialog class="toc-sheet" data-toc-sheet aria-label={t('post.toc')}>
      <div class="sheet-inner">
        <span class="handle" aria-hidden="true" />
        <div class="sheet-head">
          <span class="sheet-title">{t('post.toc')}</span>
          <button type="button" class="icon-btn" data-toc-close aria-label={t('post.tocClose')}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
        <nav>
          {headings.map((h) => (
            <a href={`#${h.slug}`} data-sheet-link={h.slug} class:list={[`depth-${h.depth}`]}>
              {h.text}
            </a>
          ))}
        </nav>
      </div>
    </dialog>
  )
}

<style>
  .capsule-bar {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(20px + env(safe-area-inset-bottom));
    z-index: 30;
    display: flex;
    gap: 8px;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .capsule-bar[hidden] {
    display: none;
  }
  .capsule-bar.is-hidden {
    transform: translateY(calc(100% + 40px));
    opacity: 0;
    pointer-events: none;
  }
  .capsule {
    height: 56px;
    border: 1px solid var(--capsule-border);
    border-radius: 999px;
    background: var(--capsule-bg);
    color: var(--capsule-text);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
    cursor: pointer;
    padding: 0;
  }
  .capsule-section {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  .capsule-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--progress, 0) * 100%);
    background: var(--capsule-fill);
  }
  .capsule-content {
    position: relative;
    height: 100%;
    padding: 0 22px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
  }
  .capsule-content svg {
    flex-shrink: 0;
  }
  .capsule-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .capsule-top {
    flex: 0 0 56px;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toc-sheet {
    margin: auto 0 0;
    width: 100%;
    max-width: 100%;
    max-height: 75vh;
    padding: 0;
    border: 0;
    border-radius: 20px 20px 0 0;
    background: var(--bg);
    color: var(--text);
  }
  .toc-sheet::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }
  .sheet-inner {
    padding: 12px 8px calc(24px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
  }
  .handle {
    align-self: center;
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: var(--border);
    margin-bottom: 4px;
  }
  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px 0 12px;
  }
  .sheet-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }
  .toc-sheet nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .toc-sheet nav a {
    min-height: 48px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 16px;
  }
  .toc-sheet nav a.depth-3 {
    padding-left: 28px;
    font-size: 15px;
    color: var(--muted);
  }
  .toc-sheet nav a[aria-current='location'] {
    background: var(--tint);
    color: var(--accent-text);
    font-weight: 700;
  }

  @media (min-width: 1024px) {
    .capsule-bar,
    .toc-sheet {
      display: none !important;
    }
  }
</style>
